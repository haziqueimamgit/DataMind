# DataPilot Backend Environment Configuration
# Copy this to .env and fill in values

# App settings
APP_NAME=DataPilot
APP_VERSION=1.0.0
DEBUG=true
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database (SQLite for local dev, swap to PostgreSQL URL for production)
DATABASE_URL=sqlite:///./datapilot.db

# CORS – frontend origin
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# AI Provider (optional – demo works without this)
# OPENAI_API_KEY=sk-...
# AI_MODEL=gpt-4o-mini
AI_MODEL=demo   # set to "demo" to use built-in rule-based requirement parser
